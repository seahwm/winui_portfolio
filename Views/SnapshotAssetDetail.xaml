<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="winui_portfolio.Views.SnapshotAssetDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:winui_portfolio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch" MaxWidth="700">
                <TextBlock x:Name="TitleTextBlock" FontSize="22" FontWeight="Bold"/>

                <Grid ColumnSpacing="16" RowSpacing="16" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: 资产名称 & 资产类型 -->
                    <TextBox x:Name="NameInput"
                             Grid.Row="0"
                             Grid.Column="0"
                             Text="{x:Bind asset.Name, Mode=OneWay}"
                             Header="资产名称"
                             PlaceholderText="例如: 定期存款, 股票投资..."
                             HorizontalAlignment="Stretch"/>

                    <ComboBox x:Name="AssetTypeComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Text="{x:Bind asset.AssetType.Name, Mode=OneWay}"
                              SelectionChanged="AssetTypeComboBox_SelectionChanged"
                              Header="资产类型"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name"/>

                    <!-- Row 1: 成本 & 价值 -->
                    <NumberBox x:Name="CostInput"
                               Grid.Row="1"
                               Grid.Column="0"
                               Text="{x:Bind FormatCurrency(asset.Cost), Mode=OneWay}"
                               Header="成本"
                               PlaceholderText="0.00"
                               Visibility="{x:Bind GetCostVisibility(AssetTypeComboBox.SelectedItem), Mode=OneWay}"
                               SpinButtonPlacementMode="Compact"
                               HorizontalAlignment="Stretch"/>

                    <NumberBox x:Name="ValueInput"
                               Grid.Row="1"
                               Grid.Column="{x:Bind GetValueColumn(AssetTypeComboBox.SelectedItem), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind GetValueColumnSpan(AssetTypeComboBox.SelectedItem), Mode=OneWay}"
                               Text="{x:Bind FormatCurrency(asset.Value), Mode=OneWay}"
                               Header="价值"
                               PlaceholderText="0.00"
                               SpinButtonPlacementMode="Compact"
                               HorizontalAlignment="Stretch"/>

                    <!-- Row 2: 货币 & 备注 -->
                    <ComboBox x:Name="CurrencyComboBox"
                              Grid.Row="2"
                              Grid.Column="0"
                              Text="{x:Bind asset.Currency, Mode=OneWay}"
                              Header="货币"
                              HorizontalAlignment="Stretch">
                        <x:String>MYR</x:String>
                        <x:String>USD</x:String>
                    </ComboBox>

                    <TextBox x:Name="RemarkInput"
                             Grid.Row="2"
                             Grid.Column="1"
                             Header="备注 (Remark)"
                             PlaceholderText="输入资产备注..."
                             HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- 股票持仓明细快捷入口 -->
                <Border x:Name="StockHoldingCard"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                <TextBlock Text="股票持仓明细" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="StockCountDescText" Text="当前包含 0 只股票" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Click="OpenStockPage_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="10,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="股票详情" FontSize="12"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 操作按钮区 -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,16">
                    <Button x:Name="DeleteButton"
                            Click="DeleteButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="删除" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="保存" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
