<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="winui_portfolio.Views.SnapshotUpdate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:winui_portfolio.Views"
    xmlns:models="using:winui_portfolio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="*,*">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar: Back Button + Date Picker + Add Button -->
        <Grid Grid.ColumnSpan="2" Grid.Row="0" Margin="12,10,12,10" ColumnDefinitions="Auto,*,Auto">
            <!-- Back Button & Date Picker -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="返回资产记录"
                        Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0"/>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                    <TextBlock Text="记录日期：" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <CalendarDatePicker x:Name="SnapshotDatePicker"
                                        DateChanged="SnapshotDatePicker_DateChanged"
                                        PlaceholderText="选择日期"/>

                    <!-- USD Exchange Rate -->
                    <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="8,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="美元汇率：" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="UsdRateTextBox"
                                 Width="110"
                                 PlaceholderText="例如 6.78"
                                 VerticalAlignment="Center"
                                 Margin="0,0,4,0">
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScope.Names>
                                        <InputScopeName NameValue="Number" />
                                    </InputScope.Names>
                                </InputScope>
                            </TextBox.InputScope>
                        </TextBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Header Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Click="SaveSnapshot_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" />
                        <TextBlock Text="保存快照" />
                    </StackPanel>
                </Button>
                <Button Click="AddAsset_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="添加资产" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Left: Asset List -->
        <ListBox Grid.Row="1" x:Name="AssetListBox" ItemsSource="{x:Bind snapshot.Assets, Mode=OneWay}" SelectionChanged="AssetListBox_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Asset">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <FontIcon Grid.Column="0" Glyph="{x:Bind local:SnapshotUpdate.GetAssetIconGlyph(AssetType), Mode=OneWay}" FontSize="16" Foreground="{x:Bind local:SnapshotUpdate.GetAssetIconBrush(AssetType), Mode=OneWay}" VerticalAlignment="Center"/>

                        <!-- Name & Category/Currency -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind AssetType.Name, TargetNullValue=''}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <Border Visibility="{x:Bind local:SnapshotUpdate.GetStockBadgeVisibility(AssetType), Mode=OneWay}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="3"
                                        Padding="4,1">
                                    <TextBlock Text="股票持仓" FontSize="9" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Remark}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind local:SnapshotUpdate.GetRemarkVisibility(Remark), Mode=OneWay}"/>
                        </StackPanel>

                        <!-- Prices (均价 / 现价) -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                            <!-- 均价 (成本): 仅当不是 ValOnly 时显示 -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind local:SnapshotUpdate.GetAvgPriceVisibility(AssetType), Mode=OneWay}">
                                <TextBlock Text="均价:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Currency}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind local:SnapshotUpdate.FormatCurrency(Cost)}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind local:SnapshotUpdate.GetProfitLossRateText(Cost, Value)}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind local:SnapshotUpdate.GetProfitLossRateBrush(Cost, Value)}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 现价 (价值): 始终显示 -->
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="现价:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Currency}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind local:SnapshotUpdate.FormatCurrency(Value)}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Right: Detail Frame -->
        <Frame x:Name="DetailFrame" Grid.Row="1" Grid.Column="1"/>
    </Grid>
</Page>
