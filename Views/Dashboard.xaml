<Page
    x:Class="winui_portfolio.Views.Dashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:winui_portfolio.Views"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 卡片统一样式定义 (Card Base Style) -->
        <Style x:Key="MetricCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,32" Spacing="20">

            <!-- 顶部标题与简要描述 (Header Section) -->
            <StackPanel Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="投资组合概览 (Portfolio Dashboard)" />
                <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="实时跟踪个人总净值、现金流与股票资产分布" />
            </StackPanel>

            <!-- 核心财务指标 (Key Metrics Section: 4列 x 2行，彻底解决窗口未最大化时的溢出问题) -->
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. 总资产 (Total Assets) -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="总资产 (Total Assets)" />
                            <FontIcon Glyph="&#xE8C7;" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="TotalAssetsTextBlock" FontSize="22" FontWeight="Bold" Text="RM 0.00" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="包含流动与固定资产" />
                    </StackPanel>
                </Border>

                <!-- 2. 总债务 (Total Debt) -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="总债务 (Total Debt)" />
                            <FontIcon Glyph="&#xE8C6;" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="TotalDebtTextBlock" FontSize="22" FontWeight="Bold" Foreground="#E05656" Text="RM 0.00" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="贷款及信用卡欠款" />
                    </StackPanel>
                </Border>

                <!-- 3. 净资产 (Net Worth - 突出显示) -->
                <Border Grid.Row="0" Grid.Column="2" 
                        Background="{ThemeResource AccentFillColorDefaultBrush}" 
                        BorderThickness="0" 
                        CornerRadius="8" 
                        Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="White" Opacity="0.9" Text="净资产 (Net Worth)" />
                            <FontIcon Glyph="&#xE946;" HorizontalAlignment="Right" FontSize="16" Foreground="White" Opacity="0.9" />
                        </Grid>
                        <TextBlock x:Name="NetWorthTextBlock" FontSize="22" FontWeight="Bold" Foreground="White" Text="RM 0.00" />
                        <TextBlock FontSize="11" Foreground="White" Opacity="0.8" Text="资产减去负债余额" />
                    </StackPanel>
                </Border>

                <!-- 4. 股票资产 (Stock Assets) -->
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="股票资产 (Stock Assets)" />
                            <FontIcon Glyph="&#xE9D9;" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="StockAssetsTextBlock" FontSize="22" FontWeight="Bold" Text="RM 0.00" />
                        <TextBlock x:Name="StockAssetsRatioTextBlock" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="占总资产比例" />
                    </StackPanel>
                </Border>

                <!-- 5. 股票收益 (Stock Returns) -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="股票收益 (Total Return)" />
                            <FontIcon Glyph="&#xE8E5;" HorizontalAlignment="Right" FontSize="16" Foreground="#107C41" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="StockReturnsTextBlock" FontSize="22" FontWeight="Bold" Foreground="#107C41" Text="RM 0.00" />
                            <Border x:Name="StockReturnsBadgeBorder" Background="#E6F4EA" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="StockReturnsBadgeTextBlock" FontSize="11" FontWeight="SemiBold" Foreground="#107C41" Text="+0.0%" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="累计未实现盈亏" />
                    </StackPanel>
                </Border>

                <!-- 6. 流动资产 (无债务) (Liquidity Asset without Debt) -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       Text="流动资产 (无债务)" ToolTipService.ToolTip="Liquidity Asset without debt" />
                            <FontIcon Glyph="&#xE7C1;" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="LiquidityWithoutDebtTextBlock" FontSize="22" FontWeight="Bold" Text="RM 0.00" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="扣除即时负债后的现金" />
                    </StackPanel>
                </Border>

                <!-- 7. 流动资产 (无父母/无债务) (Liquidity Asset without Parents/Debt) -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       Text="流动资产 (无父母/债务)" ToolTipService.ToolTip="Liquidity Asset without parent without debt" />
                            <FontIcon Glyph="&#xE8FA;" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="LiquidityWithoutParentsWithoutDebtTextBlock" FontSize="22" FontWeight="Bold" Text="RM 0.00" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="完全独立可支配流动金" />
                    </StackPanel>
                </Border>

                <!-- 8. 退休资产 (Retirement Asset) -->
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       Text="退休资产 (Retirement)" ToolTipService.ToolTip="Retirement Asset" />
                            <FontIcon Glyph="&#xE779;" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="RetirementAssetTextBlock" FontSize="22" FontWeight="Bold" Text="RM 0.00" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="公积金 / 退休金账户" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 折线图区域: 年度资产变化 (Line Chart Section) -->
            <Border Style="{StaticResource MetricCardBorderStyle}" Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="年度资产变化趋势 (Yearly Asset Trends)" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="历史资产复合增长表现" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <ToggleButton x:Name="ShowDataLabelsToggleButton" Click="ShowDataLabelsToggleButton_Click" ToolTipService.ToolTip="在折线图各数据点上显示/隐藏数值">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="13" />
                                    <TextBlock Text="显示数值" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </ToggleButton>
                            <ComboBox x:Name="AssetTrendComboBox" MinWidth="220" SelectedIndex="0" SelectionChanged="AssetTrendComboBox_SelectionChanged">
                                <ComboBoxItem Content="净资产 (Net Worth)" />
                                <ComboBoxItem Content="股票资产 (Stock Assets)" />
                                <ComboBoxItem Content="流动资产 (无父母/无债务)" />
                                <ComboBoxItem Content="股票收益率 (Stock Return Rate)" />
                                <ComboBoxItem Content="父母投资资产 (Parents Investment Assets)" />
                                <ComboBoxItem Content="父母投资收益率 (Parents Return Rate)" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <!-- LiveCharts 折线图控件 -->
                    <lvc:CartesianChart x:Name="AssetHistoryChart" Height="300" />
                </StackPanel>
            </Border>

            <!-- 饼图区域: 资产分布剖析 (Pie Charts Section) -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 饼图 1: 股票市场占比 (Market Allocation) -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="股票市场分布 (Market)" />
                        <lvc:PieChart x:Name="MarketPieChart" Height="240" />
                    </StackPanel>
                </Border>

                <!-- 饼图 2: 股票类型占比 (Type/Style Allocation) -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="股票类型风格 (Styles)" />
                        <lvc:PieChart x:Name="StockTypePieChart" Height="240" />
                    </StackPanel>
                </Border>

                <!-- 饼图 3: 个股持仓占比 (Holding Allocation: 独占一行以容纳图例与多只股票) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource MetricCardBorderStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="个股持仓分布 (Holdings)" />
                        <lvc:PieChart x:Name="StockPieChart" LegendPosition="Right" Height="260" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
