            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="3" Grid.Column="0" Height="200">
            <TextBlock Text="资产总览" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="Black" Width="200">
            <TextBlock Text="Snapshot" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        </Border>
        <Border Grid.Row="1"  Grid.Column="1" Background="Blue"  Width="200">
            <TextBlock Text="Asset" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        </Border>
        <Border Grid.Row="1"  Grid.Column="2" Background="Gray">
            <TextBlock Text="Detail" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        </Border>-->

    </Grid>
</Page>
