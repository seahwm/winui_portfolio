<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="winui_portfolio.Views.AssetSnapshot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:winui_portfolio.Views"
    xmlns:models="using:winui_portfolio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <Grid  ColumnDefinitions="2*,3*">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.ColumnSpan="2" Grid.Row="0" Margin="5" HorizontalAlignment="Right">
            <Button Click="AddSnapshot_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock Text="添加日期" />
                </StackPanel>
            </Button>
        </StackPanel>
      
        <ListBox Grid.Row="1" Name="snapShotList" ItemsSource="{x:Bind snapshots}" SelectionChanged="snapShotList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Snapshot">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 前缀图标，可以是 SymbolIcon 或 Image -->
                        <SymbolIcon Symbol="Calendar" />

                        <!-- 显示实体的属性 -->
                        <TextBlock Text="{x:Bind Date.ToLongDateString()}"/>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Frame x:Name="SummaryFrame" Grid.Row="1" Grid.Column="1"/>
        
        
        <!--<Grid.RowDefinitions>
